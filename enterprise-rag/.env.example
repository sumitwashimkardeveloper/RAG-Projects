# Application Configuration
APP_NAME=Enterprise Knowledge RAG
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=True

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/enterprise_rag
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vector Database - Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_NAMESPACE=default

# Vector Database - Weaviate (Alternative)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSION=1536

# LLM Configuration - OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# LLM Configuration - Anthropic (Alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# LLM Configuration - Local Model (Optional)
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=mistral
USE_LOCAL_LLM=False

# Confluence Configuration
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACES=["SPACE1", "SPACE2"]
CONFLUENCE_SYNC_INTERVAL_HOURS=24

# Notion Configuration
NOTION_API_KEY=your-notion-api-key
NOTION_DATABASE_IDS=["db-id-1", "db-id-2"]
NOTION_SYNC_INTERVAL_HOURS=24

# SharePoint Configuration
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITES=["https://yourorg.sharepoint.com/sites/site1"]
SHAREPOINT_SYNC_INTERVAL_HOURS=24

# Google Drive Configuration
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_FOLDER_IDS=["folder-id-1", "folder-id-2"]
GOOGLE_SYNC_INTERVAL_HOURS=24

# Email Configuration (for archived emails)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-app-password
EMAIL_SYNC_INTERVAL_HOURS=24

# Celery Configuration (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# Monitoring & Logging
SENTRY_DSN=
LOG_FORMAT=json
ENABLE_PROMETHEUS_METRICS=True
PROMETHEUS_PORT=9090

# Retrieval Configuration
MAX_RETRIEVED_DOCUMENTS=10
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
SIMILARITY_THRESHOLD=0.5
ENABLE_RERANKING=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Document Processing
MAX_DOCUMENT_SIZE_MB=50
SUPPORTED_FILE_TYPES=["pdf", "docx", "xlsx", "csv", "txt", "md", "pptx"]
ENABLE_OCR=False

# Caching
CACHE_TTL_SECONDS=3600
QUERY_RESULT_CACHE_TTL=1800
EMBEDDING_CACHE_ENABLED=True

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Admin Configuration
ADMIN_EMAIL=admin@company.com
ENABLE_ADMIN_PANEL=True

# Feature Flags
ENABLE_STREAMING_RESPONSES=True
ENABLE_FEEDBACK_COLLECTION=True
ENABLE_USAGE_TRACKING=True
ENABLE_COST_TRACKING=True
